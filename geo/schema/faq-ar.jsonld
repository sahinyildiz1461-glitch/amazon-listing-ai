    {
      "@type": "FAQPage",
      "@id": "https://kambo.com.tr/ar/custom-jewelry/#faq",
      "inLanguage": "ar",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "هل يمكنكم صنع خاتم من رسمي أو من صورة أرسلها؟",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "نعم. أرسل إلينا رسمك، أو صورة خاتم أعجبك، أو مجرد وصف. نُعدّ رسمًا أو تصميمًا ثلاثي الأبعاد مع سعر ثابت، ولا نبدأ التصنيع إلا بعد موافقتك على التصميم."
          }
        },
        {
          "@type": "Question",
          "name": "هل تصنعون مجوهرات حسب الطلب من الذهب وبالألماس، أم من الفضة فقط؟",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "كلاهما. معظم قطعنا من الفضة عيار 925، ونصنع أيضًا قطعًا حسب الطلب من الذهب عيار 14 وعيار 18، بالألماس الطبيعي والأحجار الكريمة الطبيعية."
          }
        },
        {
          "@type": "Question",
          "name": "هل أحجاركم الكريمة طبيعية؟",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "نستخدم الأحجار الكريمة الطبيعية في معظم القطع. وإذا كان الحجر معالَجًا أو مصنّعًا في المختبر، نذكر ذلك في وصف المنتج وفي عرض السعر، لتعرف دائمًا ما تشتريه."
          }
        },
        {
          "@type": "Question",
          "name": "هل الفضة لديكم فضة حقيقية عيار 925؟",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "نعم. مجوهراتنا الفضية مصنوعة من فضة إسترلينية مصمتة عيار 925 ومدموغة بعيار 925، وليست نحاسًا مطليًا بالفضة."
          }
        },
        {
          "@type": "Question",
          "name": "كم يستغرق تصنيع القطعة حسب الطلب؟",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "يستغرق التصنيع عادةً {{PRODUCTION_DAYS}} أيام عمل بعد موافقتك على التصميم، يُضاف إليها وقت الشحن إلى بلدك."
          }
        },
        {
          "@type": "Question",
          "name": "هل تشحنون إلى جميع أنحاء العالم؟",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "نعم. نشحن من تركيا إلى العملاء في جميع أنحاء العالم، مع التتبّع والتأمين."
          }
        },
        {
          "@type": "Question",
          "name": "هل يمكنكم نقش الأسماء والتواريخ والخط العربي والآيات؟",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "نعم. ننقش الأسماء والتواريخ والحروف الأولى، والخط العربي والعثماني بما في ذلك الآيات. ننقش النص تمامًا كما ترسله، ونعرضه عليك أولًا لتوافق عليه."
          }
        },
        {
          "@type": "Question",
          "name": "كيف أعرف مقاس خاتمي؟",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "أخبرنا بمقاسك بأي نظام (الأمريكي US، أو الأوروبي EU، أو البريطاني بالحروف، أو التركي)، أو بالقطر الداخلي لخاتم يناسبك بالمليمتر، ونحن نحوّله لك. فمثلًا المقاس البريطاني P يعادل تقريبًا US 7¾ وEU 56، والقطر الداخلي 22 مم يعادل تقريبًا US 12¾ وEU 69."
          }
        },
        {
          "@type": "Question",
          "name": "هل يمكنكم تعديل مقاس الخاتم أو نسخ قطعة عائلية قديمة؟",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "نعم. نعدّل المقاسات، ونستبدل الأحجار، ونعيد صنع القطع المتوارثة أو المفقودة من صورها."
          }
        },
        {
          "@type": "Question",
          "name": "كم تكلفة الخاتم حسب الطلب؟",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "يبدأ سعر خاتم الفضة عيار 925 حسب الطلب من {{PRICE_SILVER_FROM}}، أما قطع الذهب والألماس فيعتمد سعرها على الوزن والأحجار. وتحصل على عرض سعر ثابت قبل تصنيع أي شيء."
          }
        }
      ]
    }
  ]
